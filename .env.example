# Optional AI provider (OpenAI-compatible chat completions). Without it the
# deterministic rule-based analyst is used and the demo works fully offline.
BUGHUNTER_AI_BASE_URL=
BUGHUNTER_AI_API_KEY=
BUGHUNTER_AI_MODEL=

# Runtime
BUGHUNTER_DB=data/bughunter.db
BUGHUNTER_DEMO_PORT=8090
# Comma-separated port allowlist; empty means allow any loopback port.
BUGHUNTER_ALLOWED_PORTS=
# External http/https targets are allowed by default. Private, loopback,
# link-local and cloud metadata addresses stay blocked.
BUGHUNTER_ALLOW_EXTERNAL_TARGETS=1
BUGHUNTER_ALLOWED_HOSTS=
# Dangerous: allows testing 10.*, 192.168.*, 127.* and similar addresses.
BUGHUNTER_ALLOW_PRIVATE_TARGETS=0
BUGHUNTER_REQUIRE_DEMO_TARGET=1
BUGHUNTER_RUN_TIMEOUT=120